@echo off
chcp 65001 >nul
echo ================================================================================
echo                           GitHub回滚工具
echo ================================================================================
echo.
echo 正在回滚代码到上一个版本...

REM 回滚最近的提交（如果有的话）
echo 步骤 1/4: 检查Git状态...
git status

echo.
echo 步骤 2/4: 回滚最近的提交（如果有）...
git reset --hard HEAD~1 2>nul

echo.
echo 步骤 3/4: 强制推送到GitHub（覆盖之前的推送）...
git push --force origin main

if %errorlevel% equ 0 (
    echo.
    echo ✅ 回滚成功！
    echo 项目已回滚到上一个版本
) else (
    echo.
    echo ❌ 回滚失败，请手动处理
)

echo.
echo 步骤 4/4: 验证回滚结果...
git log --oneline -3

echo.
echo ================================================================================
echo                           回滚完成！
echo ================================================================================
echo.
pause
